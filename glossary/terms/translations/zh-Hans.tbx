<?xml version="1.0" encoding="UTF-8"?>
<martif type="TBX" xml:lang="en_US">
    <martifHeader>
        <fileDesc>
            <sourceDesc>
                <p>Juno: New Origins - celestial bodies and core vocabulary. Celestial body names are mostly mythological or foreign-language references rather than invented words: treat each as a proper name, keeping the English form unless your language conventionally transliterates, and then stay consistent. Planet/moon relationships come from Career/Default/Exploration.xml.</p>
            </sourceDesc>
        </fileDesc>
    </martifHeader>
    <text>
        <body>
            <termEntry id="body-00">
                <descrip type="definition">The star at the centre of the main system. The game is named after it.</descrip>
                <langSet xml:lang="en"><tig><term>Juno</term></tig></langSet>
            </termEntry>
            <termEntry id="body-01">
                <descrip type="definition">The home planet, where players launch from. Wordplay on the studio name, Jundroo.</descrip>
                <langSet xml:lang="en"><tig><term>Droo</term></tig></langSet>
            </termEntry>
            <termEntry id="body-02">
                <descrip type="definition">A moon of Droo. Named after Brigantium, the Roman name for the city of A Coruna.</descrip>
                <langSet xml:lang="en"><tig><term>Brigo</term></tig></langSet>
            </termEntry>
            <termEntry id="body-03">
                <descrip type="definition">A moon of Droo, sharing the Latin name of our own Moon.</descrip>
                <langSet xml:lang="en"><tig><term>Luna</term></tig></langSet>
            </termEntry>
            <termEntry id="body-04">
                <descrip type="definition">A moon of Droo. Keep the letters and both periods exactly as written.</descrip>
                <langSet xml:lang="en"><tig><term>T.T.</term></tig></langSet>
            </termEntry>
            <termEntry id="body-05">
                <descrip type="definition">A planet, tidally locked to Juno and the hottest world in the system. Named after Vulcan, the Roman god of fire.</descrip>
                <langSet xml:lang="en"><tig><term>Vulco</term></tig></langSet>
            </termEntry>
            <termEntry id="body-06">
                <descrip type="definition">A planet, volcanic, with lava lakes and obsidian terrain. The name was coined by the community, referencing sergals.</descrip>
                <langSet xml:lang="en"><tig><term>Sergeaa</term></tig></langSet>
            </termEntry>
            <termEntry id="body-07">
                <descrip type="definition">A moon of Sergeaa. The name is "Droo" spelled backwards. If your language transliterates Droo, mirror that here so the reversal still reads - this relationship matters more than the letters.</descrip>
                <langSet xml:lang="en"><tig><term>Oord</term></tig></langSet>
            </termEntry>
            <termEntry id="body-08">
                <descrip type="definition">A planet, the game's Mars analogue. The name was picked for its sound and carries no meaning.</descrip>
                <langSet xml:lang="en"><tig><term>Cylero</term></tig></langSet>
            </termEntry>
            <termEntry id="body-09">
                <descrip type="definition">A moon of Cylero. Named after Niobe of Greek mythology.</descrip>
                <langSet xml:lang="en"><tig><term>Niobe</term></tig></langSet>
            </termEntry>
            <termEntry id="body-10">
                <descrip type="definition">A moon of Cylero. Named after the herma, a Greek sculpture associated with Hermes.</descrip>
                <langSet xml:lang="en"><tig><term>Herma</term></tig></langSet>
            </termEntry>
            <termEntry id="body-11">
                <descrip type="definition">A comet. The name is wordplay on Halley's Comet and Andrew, the creator of the game.</descrip>
                <langSet xml:lang="en"><tig><term>Handrew's Comet</term></tig></langSet>
            </termEntry>
            <termEntry id="body-12">
                <descrip type="definition">A planet. The name was proposed by the community. It shares the "-dos" ending with Urados on purpose; keep the two matching in your language.</descrip>
                <langSet xml:lang="en"><tig><term>Tydos</term></tig></langSet>
            </termEntry>
            <termEntry id="body-13">
                <descrip type="definition">A moon of Tydos. "Nebra" is the Galician word for fog.</descrip>
                <langSet xml:lang="en"><tig><term>Nebra</term></tig></langSet>
            </termEntry>
            <termEntry id="body-14">
                <descrip type="definition">A moon of Tydos. Inherited from a community project, where the name referenced the moon Miranda; it was later reworked to resemble Iapetus.</descrip>
                <langSet xml:lang="en"><tig><term>Miros</term></tig></langSet>
            </termEntry>
            <termEntry id="body-15">
                <descrip type="definition">A moon of Tydos. Named after Orcus of Roman mythology.</descrip>
                <langSet xml:lang="en"><tig><term>Orcus</term></tig></langSet>
            </termEntry>
            <termEntry id="body-16">
                <descrip type="definition">A planet. The name blends Uranus with the "-dos" ending of Tydos; the two planets are meant to share that ending, so keep them matching in your language.</descrip>
                <langSet xml:lang="en"><tig><term>Urados</term></tig></langSet>
            </termEntry>
            <termEntry id="body-17">
                <descrip type="definition">A moon of Urados. The name blends Jastro, a well-known member of the community, with Janus.</descrip>
                <langSet xml:lang="en"><tig><term>Jastrus</term></tig></langSet>
            </termEntry>
            <termEntry id="body-18">
                <descrip type="definition">A moon of Urados. Named after Boreas of Greek mythology.</descrip>
                <langSet xml:lang="en"><tig><term>Boreas</term></tig></langSet>
            </termEntry>
            <termEntry id="body-19">
                <descrip type="definition">A moon of Urados. The name was proposed by the community.</descrip>
                <langSet xml:lang="en"><tig><term>Taurus</term></tig></langSet>
            </termEntry>
            <termEntry id="body-20">
                <descrip type="definition">A moon of Urados. The name blends Hypatch, a well-known member of the community, with Hyperion.</descrip>
                <langSet xml:lang="en"><tig><term>Hypatchion</term></tig></langSet>
            </termEntry>
            <termEntry id="body-21">
                <descrip type="definition">A celestial body. "Cladh" is Scottish Gaelic for graveyard.</descrip>
                <langSet xml:lang="en"><tig><term>Cladh</term></tig></langSet>
            </termEntry>
            <termEntry id="term-00">
                <descrip type="definition">Anything the player builds and flies - rocket, plane, rover, probe or station. The general word; prefer it over 'vehicle' or 'ship' unless the English says otherwise.</descrip>
                <langSet xml:lang="en"><tig><term>craft</term></tig></langSet>
            </termEntry>
            <termEntry id="term-01">
                <descrip type="definition">A single component placed in the Designer (a tank, wing, engine). The building block of a craft.</descrip>
                <langSet xml:lang="en"><tig><term>part</term></tig></langSet>
            </termEntry>
            <termEntry id="term-02">
                <descrip type="definition">A group of parts activated together, and the act of separating them. Both noun and verb appear in the UI.</descrip>
                <langSet xml:lang="en"><tig><term>stage</term></tig></langSet>
            </termEntry>
            <termEntry id="term-03">
                <descrip type="definition">The ordered list of stages, and the system that fires them in sequence.</descrip>
                <langSet xml:lang="en"><tig><term>staging</term></tig></langSet>
            </termEntry>
            <termEntry id="term-04">
                <descrip type="definition">A numbered group of parts toggled together by the player. Always paired with a number in the UI.</descrip>
                <langSet xml:lang="en"><tig><term>activation group</term></tig></langSet>
            </termEntry>
            <termEntry id="term-05">
                <descrip type="definition">The part that gives a craft control. Deliberately broad: it may be a crewed space capsule, a bare probe chip, or an open seat with a Drood sitting in it. Do not narrow it to 'capsule' or 'cockpit' - a craft without one cannot be steered, and that is the point of the term.</descrip>
                <langSet xml:lang="en"><tig><term>command pod</term></tig></langSet>
            </termEntry>
            <termEntry id="term-06">
                <descrip type="definition">A saved cluster of parts reused across craft. One word in this game, not 'sub-assembly'.</descrip>
                <langSet xml:lang="en"><tig><term>subassembly</term></tig></langSet>
            </termEntry>
            <termEntry id="term-07">
                <descrip type="definition">The build-mode scene where craft are assembled. Capitalised when naming the scene.</descrip>
                <langSet xml:lang="en"><tig><term>Designer</term></tig></langSet>
            </termEntry>
            <termEntry id="term-08">
                <descrip type="definition">The career-mode progression screen where parts and features are unlocked.</descrip>
                <langSet xml:lang="en"><tig><term>Tech Tree</term></tig></langSet>
            </termEntry>
            <termEntry id="term-09">
                <descrip type="definition">The career-mode currency spent to unlock nodes in the Tech Tree, earned by flying and completing objectives. Abbreviated TP directly after the number, as in '250TP'. Keep the abbreviation.</descrip>
                <langSet xml:lang="en"><tig><term>Tech Points</term></tig></langSet>
            </termEntry>
            <termEntry id="term-10">
                <descrip type="definition">A game mode: everything unlocked, no funds, no objectives. A mode name.</descrip>
                <langSet xml:lang="en"><tig><term>Sandbox</term></tig></langSet>
            </termEntry>
            <termEntry id="term-11">
                <descrip type="definition">A game mode: contracts, funds, and parts unlocked through the Tech Tree. A mode name.</descrip>
                <langSet xml:lang="en"><tig><term>Career</term></tig></langSet>
            </termEntry>
            <termEntry id="term-12">
                <descrip type="definition">A game mode, sitting between Sandbox and Career: it starts with all parts unlocked, a large amount of money, and cheats available, while keeping career features. A mode name. Do not confuse it with 'Hybrid Jets', which is an engine type and unrelated.</descrip>
                <langSet xml:lang="en"><tig><term>Hybrid</term></tig></langSet>
            </termEntry>
            <termEntry id="term-13">
                <descrip type="definition">A career-mode job offering a reward for completing objectives.</descrip>
                <langSet xml:lang="en"><tig><term>contract</term></tig></langSet>
            </termEntry>
            <termEntry id="term-14">
                <descrip type="definition">In career mode this is a precise term, not a general one: the specific part a contract requires a craft to carry to its objective. The UI warns when it is missing from the craft, so translate it as a definite, identifiable part rather than as 'cargo' in general.</descrip>
                <langSet xml:lang="en"><tig><term>payload</term></tig></langSet>
            </termEntry>
            <termEntry id="term-15">
                <descrip type="definition">The navigation ball showing the craft's orientation and manoeuvre directions.</descrip>
                <langSet xml:lang="en"><tig><term>nav sphere</term></tig></langSet>
            </termEntry>
            <termEntry id="term-16">
                <descrip type="definition">The engine power control, as noun and verb.</descrip>
                <langSet xml:lang="en"><tig><term>throttle</term></tig></langSet>
            </termEntry>
            <termEntry id="term-17">
                <descrip type="definition">The force an engine produces.</descrip>
                <langSet xml:lang="en"><tig><term>thrust</term></tig></langSet>
            </termEntry>
            <termEntry id="term-18">
                <descrip type="definition">Aerodynamic resistance opposing motion through an atmosphere.</descrip>
                <langSet xml:lang="en"><tig><term>drag</term></tig></langSet>
            </termEntry>
            <termEntry id="term-19">
                <descrip type="definition">The aerodynamic force a wing generates perpendicular to airflow.</descrip>
                <langSet xml:lang="en"><tig><term>lift</term></tig></langSet>
            </termEntry>
            <termEntry id="term-20">
                <descrip type="definition">The total velocity change a craft can produce. Keep the hyphen and both capitals; it is a standard aerospace term, not a coined one.</descrip>
                <langSet xml:lang="en"><tig><term>Delta-V</term></tig></langSet>
            </termEntry>
            <termEntry id="term-21">
                <descrip type="definition">Specific impulse - a measure of engine efficiency. An abbreviation; keep it as 'Isp' unless your language has an established equivalent.</descrip>
                <langSet xml:lang="en"><tig><term>Isp</term></tig></langSet>
            </termEntry>
            <termEntry id="term-22">
                <descrip type="definition">Reaction Control System - the small thrusters used for fine attitude control. Keep the abbreviation.</descrip>
                <langSet xml:lang="en"><tig><term>RCS</term></tig></langSet>
            </termEntry>
            <termEntry id="term-23">
                <descrip type="definition">The path of a craft around a celestial body, as noun and verb.</descrip>
                <langSet xml:lang="en"><tig><term>orbit</term></tig></langSet>
            </termEntry>
            <termEntry id="term-24">
                <descrip type="definition">The highest point of an orbit. Standard orbital mechanics term - use your language's established astronomical word if it has one.</descrip>
                <langSet xml:lang="en"><tig><term>Apoapsis</term></tig></langSet>
            </termEntry>
            <termEntry id="term-25">
                <descrip type="definition">The lowest point of an orbit. Standard orbital mechanics term.</descrip>
                <langSet xml:lang="en"><tig><term>Periapsis</term></tig></langSet>
            </termEntry>
            <termEntry id="term-26">
                <descrip type="definition">The tilt of an orbit relative to the body's equator, in degrees. Standard orbital mechanics term.</descrip>
                <langSet xml:lang="en"><tig><term>Inclination</term></tig></langSet>
            </termEntry>
            <termEntry id="term-27">
                <descrip type="definition">How far an orbit departs from a circle: 0 is circular, approaching 1 is a long ellipse. Standard orbital mechanics term.</descrip>
                <langSet xml:lang="en"><tig><term>Eccentricity</term></tig></langSet>
            </termEntry>
            <termEntry id="term-28">
                <descrip type="definition">Half the long axis of an elliptical orbit - the standard measure of its size.</descrip>
                <langSet xml:lang="en"><tig><term>Semi-Major Axis</term></tig></langSet>
            </termEntry>
            <termEntry id="term-29">
                <descrip type="definition">The point where an orbit crosses the reference plane going north. Standard orbital mechanics term.</descrip>
                <langSet xml:lang="en"><tig><term>Ascending Node</term></tig></langSet>
            </termEntry>
            <termEntry id="term-30">
                <descrip type="definition">The craft's angular position along its orbit, measured from periapsis. Standard orbital mechanics term.</descrip>
                <langSet xml:lang="en"><tig><term>True Anomaly</term></tig></langSet>
            </termEntry>
            <termEntry id="term-31">
                <descrip type="definition">The region where a celestial body's gravity dominates. Often abbreviated SOI in English text.</descrip>
                <langSet xml:lang="en"><tig><term>Sphere of Influence</term></tig></langSet>
            </termEntry>
            <termEntry id="term-32">
                <descrip type="definition">Any planet, moon, star, comet or asteroid. The neutral umbrella term.</descrip>
                <langSet xml:lang="en"><tig><term>celestial body</term></tig></langSet>
            </termEntry>
            <termEntry id="term-33">
                <descrip type="definition">The gas layer around a body, which produces drag and allows air-breathing engines.</descrip>
                <langSet xml:lang="en"><tig><term>atmosphere</term></tig></langSet>
            </termEntry>
            <termEntry id="term-34">
                <descrip type="definition">Returning through an atmosphere at high speed, generating heat.</descrip>
                <langSet xml:lang="en"><tig><term>re-entry</term></tig></langSet>
            </termEntry>
            <termEntry id="term-35">
                <descrip type="definition">A part storing propellant.</descrip>
                <langSet xml:lang="en"><tig><term>fuel tank</term></tig></langSet>
            </termEntry>
            <termEntry id="term-36">
                <descrip type="definition">The consumable an engine burns. Prefer the specific fuel name where the English uses one.</descrip>
                <langSet xml:lang="en"><tig><term>propellant</term></tig></langSet>
            </termEntry>
            <termEntry id="term-37">
                <descrip type="definition">A place a craft can be launched from - the built-in sites and any spot the player saves for reuse. Each has size and weight limits a craft must fit within, so it is a specific named location, not scenery.</descrip>
                <langSet xml:lang="en"><tig><term>launch location</term></tig></langSet>
            </termEntry>
            <termEntry id="term-38">
                <descrip type="definition">The Droods aboard a craft. Collective noun.</descrip>
                <langSet xml:lang="en"><tig><term>crew</term></tig></langSet>
            </termEntry>
            <termEntry id="term-39">
                <descrip type="definition">The career-mode currency used to buy parts and launch craft, distinct from Tech Points. Plural in English.</descrip>
                <langSet xml:lang="en"><tig><term>funds</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en_US"><tig><term>Tech Points</term></tig></langSet>
                <langSet xml:lang="zh-Hans"><tig><term></term></tig></langSet>
            </termEntry>
        </body>
    </text>
</martif>
