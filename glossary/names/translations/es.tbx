<?xml version="1.0" encoding="UTF-8"?>
<martif type="TBX" xml:lang="en">
    <martifHeader>
        <fileDesc>
            <sourceDesc>
                <p>Juno: New Origins - brand and proper names. Never translated; this component is flagged read-only.</p>
            </sourceDesc>
        </fileDesc>
    </martifHeader>
    <text>
        <body>
            <termEntry id="juno-new-origins">
                <descrip type="definition">The name of the game. Never translated and never reordered. The community commonly shortens it to "Juno" or "JNO" and both are fine to keep as-is; do not invent a shortening in your own language.</descrip>
                <langSet xml:lang="en"><tig><term>Juno: New Origins</term></tig></langSet>
            </termEntry>
            <termEntry id="jno">
                <descrip type="definition">The community abbreviation of "Juno: New Origins". Keep the three Latin letters unchanged.</descrip>
                <langSet xml:lang="en"><tig><term>JNO</term></tig></langSet>
            </termEntry>
            <termEntry id="vizzy">
                <descrip type="definition">The in-game visual programming language players use to script craft. A product name, not a word: keep it as "Vizzy" in every language.</descrip>
                <langSet xml:lang="en"><tig><term>Vizzy</term></tig></langSet>
            </termEntry>
            <termEntry id="funkytrees">
                <descrip type="definition">The expression language used for custom part and control inputs, also reached from the fUnK block in Vizzy. A product name: keep as "FunkyTrees", and keep the fUnK block's spelling exactly as written.</descrip>
                <langSet xml:lang="en"><tig><term>FunkyTrees</term></tig></langSet>
            </termEntry>
            <termEntry id="drood">
                <descrip type="definition">The game's characters - the crew a player flies. A proper name: do not replace it with "astronaut", "dude", or any similar word, however tempting. Transliterating it into your language's script is fine, as long as you do it consistently.</descrip>
                <langSet xml:lang="en"><tig><term>Drood</term></tig></langSet>
            </termEntry>
            <termEntry id="jundroo">
                <descrip type="definition">The studio that makes the game. Never translated.</descrip>
                <langSet xml:lang="en"><tig><term>Jundroo</term></tig></langSet>
            </termEntry>
            <termEntry id="credits-people">
                <descrip type="definition">Personal and organisation names in the credits are never translated or transliterated. Where a credit reads "by &lt;name&gt;", translate only the word "by" and leave the name exactly as written. This applies to every name in the credits screen.</descrip>
                <langSet xml:lang="en"><tig><term>Credits names</term></tig></langSet>
            </termEntry>
        </body>
    </text>
</martif>
